# StarLink CRM production configuration. Never commit real values.
# Configure backend and frontend entries in their respective Vercel projects.

# Backend Vercel project (Root Directory: backend)
APP_ENV=production
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://<neon-user>:<neon-password>@<neon-host>/<database>?sslmode=require
DATABASE_POOL_MODE=null
CORS_ORIGINS=https://<your-frontend>.vercel.app
JWT_SECRET_KEY=<at-least-32-random-characters>
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14
PRODUCT_IMAGE_BASE_URL=https://<your-frontend>.vercel.app/product-images
FILE_STORAGE_BACKEND=vercel_blob
BLOB_READ_WRITE_TOKEN=<vercel-blob-read-write-token>
COMPANY_ALIBABA_STORE=https://<your-alibaba-store>
COMPANY_WEBSITE=https://<your-company-website>
COMPANY_EMAIL=sales@<your-domain>
COMPANY_WHATSAPP=+86-<your-whatsapp-number>

# Frontend Vercel project (Root Directory: frontend)
VITE_API_BASE_URL=https://<your-backend>.vercel.app/api/v1
